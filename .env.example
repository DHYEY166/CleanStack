# CleanStack web app (Next.js) configuration.
# Copy to .env.local for local development. Never commit real values.
# Validated by src/lib/env.ts; missing required values are reported at startup.

# --- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# Aurora Serverless v2 via the RDS Data API (required)
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:000000000000:cluster:your-cluster
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:your-db-secret
# Buckets (required)
S3_RAW_BUCKET=your-raw-bucket
S3_PROCESSED_BUCKET=your-processed-bucket
# Executor queue (required; without it approved runs complete without executing)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/your-executor-queue
# Optional async AI suggestion queue
AI_QUEUE_ENABLED=false
# AI_JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/your-ai-jobs-queue

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secrets: generate with `openssl rand -hex 32` (>= 32 characters)
WEBHOOK_SECRET=
CRON_SECRET=
# Admin routes (/api/admin/*) are disabled when ADMIN_SECRET is unset
# ADMIN_SECRET=
# ADMIN_EMAILS=you@example.com
# ADMIN_USER_IDS=user_xxx

# --- Clerk (auth, required) ---------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Upstash Redis (optional: rate limiting + quota cache are off without it)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Guest access (optional: off unless GUEST_COOKIE_SECRET is set) -------
# Generate with: openssl rand -base64 48   (>= 32 chars)
# GUEST_COOKIE_SECRET=
# Optional Cloudflare Turnstile on "Try as guest" (set both or neither)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Per-file upload limit for signed-in users, MB (default 100; guests are fixed at 2).
# Keep in sync with MAX_UPLOAD_MB on the profiler Lambda.
# MAX_UPLOAD_MB=100

# Structured JSON logs: debug | info | warn | error (default info)
# LOG_LEVEL=info

# --- Sentry (optional) ---------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- TEST ONLY (integration/e2e suites; never set in a deployment) --------
# Honoured only when CLEANSTACK_TEST_MODE=1 and not on Vercel/Lambda.
# CLEANSTACK_TEST_MODE=0
# DB_DRIVER=data-api
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cleanstack

# --- Migration runner only (node src/lib/migrations/run-migration.mjs) ----
# AURORA_HOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
# AURORA_PORT=5432
# AURORA_USER=postgres
# AURORA_DB=cleanstack
# RDS_CA_BUNDLE=/path/to/global-bundle.pem
